{
    "name": "nonini/diff",
    "description": "php-diff wrapper supporting ipl/html",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Thomas Gelf",
            "email": "thomas@gelf.net"
        }
    ],
    "config": {
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "nonini\\Diff\\": "src"
        }
    },
    "require": {
        "php": ">=7.4.0",
        "ext-mbstring": "*",
        "ipl/html": ">=0.2"
    },
    "require-dev": {
        "phpstan/phpstan": "^1.10 || ^2",
        "phpunit/phpunit": "^10.3 || ^13",
        "squizlabs/php_codesniffer": "^3.7 || ^4",
        "symplify/easy-coding-standard": "^12.0.8 || ^13"
    }
}
